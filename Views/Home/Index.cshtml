<div class="form">

<h1>Recetify</h1>

<form action='@Url.Action("GenerarReceta","Home")' method="post">

    Nombre <br>
    <input type="text" name="Nombre" required>

    <br><br>

    Fecha de nacimiento <br>
    <input type="date" name="FechaNacimiento">

    <br><br>

    Tipo de comida <br>

    <input type="radio" name="TipoC" value="Caliente" required> Caliente

    <input type="radio" name="TipoC" value="Fria" required> Fria

    <br><br>

    Presupuesto <br>
    <input type="number" name="Presupuesto" required>

    <br><br>

    Cantidad de personas <br>
    <input type="number" name="Comensales" required>

    <br><br>

    <input type="submit" value="Generar receta" required>

</form>

</div>