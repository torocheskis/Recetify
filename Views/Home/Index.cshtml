<div class="form">

<h1>Recetify</h1>

<form action='@Url.Action("GenerarReceta","Home")' method="post">

    Nombre <br>
    <input type="text" name="Nombre">

    <br><br>

    Fecha de nacimiento <br>
    <input type="date" name="FechaNacimiento">

    <br><br>

    Tipo de comida <br>

    <input type="radio" name="TipoC" value="Caliente"> Caliente

    <input type="radio" name="TipoC" value="Fria"> Fria

    <br><br>

    Presupuesto <br>
    <input type="number" name="Presupuesto">

    <br><br>

    Cantidad de personas <br>
    <input type="number" name="Comensales">

    <br><br>

    <input type="submit" value="Generar receta">

</form>

</div>